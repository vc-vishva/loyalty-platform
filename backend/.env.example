# Node environment (development | production | test)
NODE_ENV=development

# Port the API listens on
PORT=3000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cowork_booking?schema=public"

# JWT secret key used to sign access + refresh tokens
JWT_SECRET=thisisasamplesecret

# Minutes after which an access token expires
JWT_ACCESS_EXPIRATION_MINUTES=15

# Days after which a refresh token expires
JWT_REFRESH_EXPIRATION_DAYS=7
