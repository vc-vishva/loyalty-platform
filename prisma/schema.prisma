// Prisma schema for the loyalty-platform API (PostgreSQL).
// Docs: https://pris.ly/d/prisma-schema
//
// Multi-tenancy: every tenant-owned table carries `businessId`. All queries are
// scoped to the businessId taken from the authenticated user's JWT.
// Money (price, amount, rewardUnitValue) is stored as integer rupees so the
// reward calculation floor(amount / rewardUnitValue) stays exact.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum TokenType {
  access
  refresh
}

enum RewardStatus {
  pending
  completed
  failed
}

model Business {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique
  rewardUnitValue Int
  createdAt       DateTime   @default(now())
  users           User[]
  products        Product[]
  purchases       Purchase[]
  rewards         Reward[]

  @@map("businesses")
}

model User {
  id              String     @id @default(uuid())
  // Nullable for now; made required (and role → admin|customer) in the auth feature.
  businessId      String?
  business        Business?  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  email           String     @unique
  password        String
  role            Role       @default(user)
  isEmailVerified Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  tokens          Token[]
  purchases       Purchase[]
  rewards         Reward[]

  @@index([businessId])
  @@map("users")
}

model Token {
  id          String    @id @default(uuid())
  token       String
  type        TokenType
  expires     DateTime
  blacklisted Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([token])
  @@map("tokens")
}

model Product {
  id          String     @id @default(uuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String
  price       Int
  stock       Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]

  @@index([businessId])
  @@map("products")
}

model Purchase {
  id         String   @id @default(uuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  amount     Int
  createdAt  DateTime @default(now())
  reward     Reward?

  @@index([businessId])
  @@index([customerId])
  @@map("purchases")
}

model Reward {
  id         String       @id @default(uuid())
  customerId String
  customer   User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseId String       @unique
  purchase   Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  points     Int
  status     RewardStatus @default(pending)
  createdAt  DateTime     @default(now())

  @@index([businessId])
  @@index([customerId])
  @@map("rewards")
}
